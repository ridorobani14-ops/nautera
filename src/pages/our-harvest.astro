---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Our Harvest | Katalog Udang Vaname Segar & Olahan Higienis | NAUTERA" description="Jelajahi varian udang vaname beku & segar NAUTERA: HOSO, HLSO, PDTO, PND, Butterfly Cut. Standar mutu ekspor tanpa glazing berlebih." extraScript="/scripts/harvest.js">
<main>
<!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-bg-media">
        <img src="/assets/images/bg-2.jpg" alt="" onerror="if(!this.dataset.tried){this.dataset.tried=1;this.src='/assets/images/hero-harvest-bg.png';}else{this.style.display='none';}">
      </div>
      <div class="hero-overlay-grid"></div>
      <div class="container">
        <div class="grid-2">
          <div class="hero-content">
            <span class="section-label">PRODUK NAUTERA</span>
            <h1>From Farm to Plate,<br>Always Fresh &amp;<br>Traceable.</h1>
            <p>Pengawasan menyeluruh di setiap mata rantai budidaya menghasilkan udang vaname bernilai tinggi yang siap memenuhi standar kuliner dan bisnis Anda.</p>
          </div>
          
        </div>
      </div>
    </section>

    <!-- Education Size Section -->
    <section id="size-selector" style="background-color: var(--color-primary-very-light); border-top: 1px solid rgba(119,171,89,0.1); border-bottom: 1px solid rgba(119,171,89,0.1);">
      <div class="container">
        <div class="section-header center reveal">
          <span class="section-label">Panduan Ukuran</span>
          <h2>Shrimp Size &amp; Classification Guide</h2>
          <p>Panduan klasifikasi ukuran dan spesifikasi berat rata-rata udang vaname per kilogram (berat bersih) untuk memudahkan perhitungan porsi dan kebutuhan menu dapur Anda:</p>
        </div>
        
        <div class="size-widget-grid">
          <!-- Left side: Select Option & Guide Info Unified Card -->
          <div class="size-selector-panel reveal">
            <!-- Dropdown Section -->
            <div class="size-select-section">
              <label for="size-select-option" class="size-select-label">
                <i class="fa-solid fa-list-check" style="color: var(--color-primary);"></i> Pilih Klasifikasi Size Udang:
              </label>
              <div class="custom-select-wrapper">
                <select id="size-select-option" class="custom-size-select">
                  <option value="10-20" selected>Size 10-20</option>
                  <option value="20-30">Size 20-30</option>
                  <option value="30-40">Size 30-40</option>
                  <option value="40-50">Size 40-50</option>
                  <option value="50-60">Size 50-60</option>
                  <option value="60-70">Size 60-70</option>
                  <option value="70-80">Size 70-80</option>
                  <option value="80-90">Size 80-90</option>
                  <option value="90-100">Size 90-100</option>
                </select>
                <div class="custom-select-arrow">
                  <i class="fa-solid fa-chevron-down"></i>
                </div>
              </div>
            </div>

            <!-- Subtle Divider -->
            <div class="size-panel-divider"></div>

            <!-- Helpful Guide Info Section -->
            <div class="size-guide-section">
              <div class="size-guide-badge">
                <span><i class="fa-solid fa-lightbulb" style="color: var(--color-primary);"></i></span> <strong>Panduan Klasifikasi Size</strong>
              </div>
              <p>Angka size menunjukkan <strong>jumlah ekor udang per 1 kg</strong>. Semakin <em>kecil</em> angkanya, ukuran udang semakin <em>besar, tebal, dan padat</em>.</p>
              <div class="size-quick-tags">
                <div class="quick-tag">
                  <i class="fa-solid fa-utensils"></i>
                  <span><strong>Size 10-40:</strong> Restoran &amp; Ekspor Premium</span>
                </div>
                <div class="quick-tag">
                  <i class="fa-solid fa-bowl-food"></i>
                  <span><strong>Size 50-70:</strong> Olahan Menu Harian &amp; Katering</span>
                </div>
                <div class="quick-tag">
                  <i class="fa-solid fa-box"></i>
                  <span><strong>Size 80-100:</strong> Dimsum, Siomay &amp; Isian Kuliner</span>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Right side: Details Card -->
          <div class="size-details-card reveal delay-100">
            <div class="size-detail-header">
              <div>
                <h3 id="detail-size-title">Size 10-20</h3>
              </div>
            </div>

            <div class="spec-tiles-grid">
              <div class="spec-tile-box">
                <div class="spec-tile-icon">
                  <i class="fa-solid fa-weight-hanging"></i>
                </div>
                <div class="spec-tile-info">
                  <span class="spec-tile-label">Rata-rata Berat / Ekor</span>
                  <span class="spec-tile-value" id="detail-size-weight">50 - 100 g/pc</span>
                </div>
              </div>

              <div class="spec-tile-box">
                <div class="spec-tile-icon">
                  <i class="fa-solid fa-scale-balanced"></i>
                </div>
                <div class="spec-tile-info">
                  <span class="spec-tile-label">Jumlah Ekor / Kg</span>
                  <span class="spec-tile-value" id="detail-size-count">10 - 20 pcs/kg</span>
                </div>
              </div>

              <div class="spec-tile-box full-width">
                <div class="spec-tile-icon">
                  <i class="fa-solid fa-utensils"></i>
                </div>
                <div class="spec-tile-info">
                  <span class="spec-tile-label">Rekomendasi Menu Kuliner</span>
                  <p class="spec-tile-desc" id="detail-size-recommendation">Sangat cocok untuk hidangan mewah restoran bintang lima, panggangan besar (barbeque), dan ekspor premium.</p>
                </div>
              </div>
            </div>
            
            <div class="size-img-wrapper">
              <div class="img-slot" id="detail-size-slot" style="min-height: 160px; max-height: 220px;">
                <img id="detail-size-img" src="/assets/images/10-20.png" alt="Size 10-20" loading="lazy" style="max-height: 200px; object-fit: contain;">
                <div class="img-slot-fallback">
                  <span class="slot-icon"><i class="fa-solid fa-camera"></i></span>
                  <span class="slot-name" id="detail-size-img-name">10-20.png</span>
                </div>
              </div>
              <span class="size-details-note" id="detail-size-note">Data resmi bersumber dari audit operasional Nautera Farm.</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Product Variant Section -->
    <section id="product-variants" style="background-color: var(--color-bg-white);">
      <div class="container">
        <div class="section-header center reveal">
          <h2>Cut Options for Every Culinary Need</h2>
          <p>Pilihan bentuk dan potongan udang vaname segar yang disesuaikan dengan kebutuhan operasional restoran, katering, dan olahan dapur keluarga.</p>
        </div>

        <div class="variant-grid">
          <!-- Card HOSO -->
          <div class="variant-card active" data-variant="HOSO">
            <div class="variant-card-img">
              <div class="img-slot img-slot-circle">
                <img src="/assets/images/hoso.png" alt="HOSO" loading="lazy">
                <div class="img-slot-fallback"><span class="slot-icon"><i class="fa-solid fa-camera"></i></span></div>
              </div>
            </div>
            <span class="variant-card-code">HOSO</span>
            <h3>Head-On Shell-On</h3>
            <p>Udang utuh segar lengkap dengan kepala, cangkang, dan ekor alami.</p>
          </div>
          <!-- Card HLSO -->
          <div class="variant-card" data-variant="HLSO">
            <div class="variant-card-img">
              <div class="img-slot img-slot-circle">
                <img src="/assets/images/hlso.png" alt="HLSO" loading="lazy">
                <div class="img-slot-fallback"><span class="slot-icon"><i class="fa-solid fa-camera"></i></span></div>
              </div>
            </div>
            <span class="variant-card-code">HLSO</span>
            <h3>Headless Shell-On</h3>
            <p>Kepala dihilangkan untuk kepraktisan dapur, cangkang dan ekor tetap terjaga.</p>
          </div>
          <!-- Card PDTO -->
          <div class="variant-card" data-variant="PDTO">
            <div class="variant-card-img">
              <div class="img-slot img-slot-circle">
                <img src="/assets/images/pdto.png" alt="PDTO" loading="lazy">
                <div class="img-slot-fallback"><span class="slot-icon"><i class="fa-solid fa-camera"></i></span></div>
              </div>
            </div>
            <span class="variant-card-code">PDTO</span>
            <h3>Peeled Deveined Tail-On</h3>
            <p>Kupas bersih dengan ekor tersisa, usus punggung telah dibersihkan rapi.</p>
          </div>
          <!-- Card PND -->
          <div class="variant-card" data-variant="PND">
            <div class="variant-card-img">
              <div class="img-slot img-slot-circle">
                <img src="/assets/images/pnd.png" alt="PND" loading="lazy">
                <div class="img-slot-fallback"><span class="slot-icon"><i class="fa-solid fa-camera"></i></span></div>
              </div>
            </div>
            <span class="variant-card-code">PND</span>
            <h3>Peeled and Deveined</h3>
            <p>Kupas bersih tanpa cangkang dan ekor, siap langsung diolah.</p>
          </div>
          <!-- Card BFLY -->
          <div class="variant-card" data-variant="BFLY">
            <div class="variant-card-img">
              <div class="img-slot img-slot-circle">
                <img src="/assets/images/bfly.png" alt="BFLY" loading="lazy">
                <div class="img-slot-fallback"><span class="slot-icon"><i class="fa-solid fa-camera"></i></span></div>
              </div>
            </div>
            <span class="variant-card-code">BFLY</span>
            <h3>Butterfly Cut</h3>
            <p>Kupas bersih dengan belahan punggung mekar sempurna, ideal untuk tempura.</p>
          </div>
        </div>

        <!-- Single Alive Modern CTA Button -->
        <div class="flex-center reveal delay-200" style="display: flex; justify-content: center; align-items: center; margin-top: 3.5rem; width: 100%; text-align: center;">
          <a href="/contact?type=b2b" class="btn-harvest-action">
            <span>Pesan &amp; Bermitra Pasokan Udang</span>
            <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </section>

    <!-- Quality Standards Section (4-Card Grid) -->
    <section style="border-top: 1px solid rgba(119,171,89,0.06);">
      <div class="container">
        <div class="section-header center reveal">
          <h2>Quality Standards at Every Point</h2>
          <p>Setiap gram udang Nautera ditangani di fasilitas pengolahan dengan standar food safety dan pengawasan mutu yang ketat.</p>
        </div>

        <div class="quality-grid-row" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-top: 3rem; align-items: stretch; position: relative;">
          
          <!-- Step 1: Panen & Sortir -->
          <div class="qs-step-card reveal delay-100">
            <div class="timeline-img-box" style="margin-bottom: 1.15rem; position: relative; overflow: hidden; border-radius: 16px;">
              <div class="img-slot" style="height: 185px; min-height: 185px; max-height: 185px; border-radius: 16px;">
                <img src="/assets/images/qs-step-1.jpg" alt="Panen Tambak Berkelanjutan" loading="lazy" style="object-fit: cover; object-position: center; transition: transform 0.4s ease;">
                <div class="img-slot-fallback"><span class="slot-icon"><i class="fa-solid fa-camera"></i></span><span class="slot-name">qs-step-1.jpg</span></div>
              </div>
              <span class="qs-step-tag">STEP 01</span>
            </div>
            <div class="timeline-badge-row" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; font-weight: 800; color: var(--color-primary-dark); font-size: 0.92rem; margin-bottom: 0.85rem; padding: 0.45rem 1rem; border-radius: 30px; background: linear-gradient(135deg, var(--color-primary-very-light), #e2f2e1); border: 1px solid var(--color-primary-light); min-height: 48px; width: 100%; box-shadow: 0 2px 8px rgba(35, 76, 32, 0.04);">
              <span class="timeline-badge-circle" style="width: 24px; height: 24px; border-radius: 50%; background: #FFFFFF; border: 1px solid var(--color-primary-light); color: var(--color-primary); display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 800; flex-shrink: 0; box-shadow: 0 2px 6px rgba(35,76,32,0.1);">01</span>
              <span>Panen &amp; Sortir</span>
            </div>
            <p style="font-size: 0.9rem; line-height: 1.55; color: var(--color-text-light); margin-bottom: 0; text-align: left; flex-grow: 1;">Proses panen terencana langsung dari kolam tambak dengan seleksi ketat mutu kesegaran udang.</p>
          </div>

          <!-- Step 2: Pencucian Air Dingin -->
          <div class="qs-step-card reveal delay-200">
            <div class="timeline-img-box" style="margin-bottom: 1.15rem; position: relative; overflow: hidden; border-radius: 16px;">
              <div class="img-slot" style="height: 185px; min-height: 185px; max-height: 185px; border-radius: 16px;">
                <img src="/assets/images/qs-step-2.jpg" alt="Pencucian Air Dingin &amp; Sortir" loading="lazy" style="object-fit: cover; object-position: center; transition: transform 0.4s ease;">
                <div class="img-slot-fallback"><span class="slot-icon"><i class="fa-solid fa-camera"></i></span><span class="slot-name">qs-step-2.jpg</span></div>
              </div>
              <span class="qs-step-tag">STEP 02</span>
            </div>
            <div class="timeline-badge-row" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; font-weight: 800; color: var(--color-primary-dark); font-size: 0.92rem; margin-bottom: 0.85rem; padding: 0.45rem 1rem; border-radius: 30px; background: linear-gradient(135deg, var(--color-primary-very-light), #e2f2e1); border: 1px solid var(--color-primary-light); min-height: 48px; width: 100%; box-shadow: 0 2px 8px rgba(35, 76, 32, 0.04);">
              <span class="timeline-badge-circle" style="width: 24px; height: 24px; border-radius: 50%; background: #FFFFFF; border: 1px solid var(--color-primary-light); color: var(--color-primary); display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 800; flex-shrink: 0; box-shadow: 0 2px 6px rgba(35,76,32,0.1);">02</span>
              <span>Pencucian Air Dingin</span>
            </div>
            <p style="font-size: 0.9rem; line-height: 1.55; color: var(--color-text-light); margin-bottom: 0; text-align: left; flex-grow: 1;">Pembersihan dan sortir manual menggunakan air dingin segar untuk menjaga keutuhan tekstur.</p>
          </div>

          <!-- Step 3: Pembekuan Cepat -->
          <div class="qs-step-card reveal delay-300">
            <div class="timeline-img-box" style="margin-bottom: 1.15rem; position: relative; overflow: hidden; border-radius: 16px;">
              <div class="img-slot" style="height: 185px; min-height: 185px; max-height: 185px; border-radius: 16px;">
                <img src="/assets/images/qs-step-3.jpg" alt="Pembekuan Cepat IQF" loading="lazy" style="object-fit: cover; object-position: center; transition: transform 0.4s ease;">
                <div class="img-slot-fallback"><span class="slot-icon"><i class="fa-solid fa-camera"></i></span><span class="slot-name">qs-step-3.jpg</span></div>
              </div>
              <span class="qs-step-tag">STEP 03</span>
            </div>
            <div class="timeline-badge-row" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; font-weight: 800; color: var(--color-primary-dark); font-size: 0.92rem; margin-bottom: 0.85rem; padding: 0.45rem 1rem; border-radius: 30px; background: linear-gradient(135deg, var(--color-primary-very-light), #e2f2e1); border: 1px solid var(--color-primary-light); min-height: 48px; width: 100%; box-shadow: 0 2px 8px rgba(35, 76, 32, 0.04);">
              <span class="timeline-badge-circle" style="width: 24px; height: 24px; border-radius: 50%; background: #FFFFFF; border: 1px solid var(--color-primary-light); color: var(--color-primary); display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 800; flex-shrink: 0; box-shadow: 0 2px 6px rgba(35,76,32,0.1);">03</span>
              <span>Pembekuan Cepat</span>
            </div>
            <p style="font-size: 0.9rem; line-height: 1.55; color: var(--color-text-light); margin-bottom: 0; text-align: left; flex-grow: 1;">Pembekuan cepat untuk mengunci rasa manis alami, kadar air, dan nutrisi udang segar.</p>
          </div>

          <!-- Step 4: Pengemasan & Distribusi -->
          <div class="qs-step-card reveal delay-400">
            <div class="timeline-img-box" style="margin-bottom: 1.15rem; position: relative; overflow: hidden; border-radius: 16px;">
              <div class="img-slot" style="height: 185px; min-height: 185px; max-height: 185px; border-radius: 16px;">
                <img src="/assets/images/qs-step-4.jpg" alt="Pengemasan &amp; Distribusi Armada" loading="lazy" style="object-fit: cover; object-position: center; transition: transform 0.4s ease;">
                <div class="img-slot-fallback"><span class="slot-icon"><i class="fa-solid fa-camera"></i></span><span class="slot-name">qs-step-4.jpg</span></div>
              </div>
              <span class="qs-step-tag">STEP 04</span>
            </div>
            <div class="timeline-badge-row" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; font-weight: 800; color: var(--color-primary-dark); font-size: 0.92rem; margin-bottom: 0.85rem; padding: 0.45rem 1rem; border-radius: 30px; background: linear-gradient(135deg, var(--color-primary-very-light), #e2f2e1); border: 1px solid var(--color-primary-light); min-height: 48px; width: 100%; box-shadow: 0 2px 8px rgba(35, 76, 32, 0.04);">
              <span class="timeline-badge-circle" style="width: 24px; height: 24px; border-radius: 50%; background: #FFFFFF; border: 1px solid var(--color-primary-light); color: var(--color-primary); display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 800; flex-shrink: 0; box-shadow: 0 2px 6px rgba(35,76,32,0.1);">04</span>
              <span>Pengemasan &amp; Distribusi</span>
            </div>
            <p style="font-size: 0.9rem; line-height: 1.55; color: var(--color-text-light); margin-bottom: 0; text-align: left; flex-grow: 1;">Pengemasan rapi dan pengiriman dengan armada berpendingin khusus hingga ke pelanggan.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Healthy Nature Section -->
    <section style="background-color: var(--color-primary-very-light); border-top: 1px solid rgba(119,171,89,0.1); border-bottom: 1px solid rgba(119,171,89,0.1);">
      <div class="container">
        <div class="grid-2">
          <div class="reveal">
            <h2>Healthy Nature, Better Shrimp Harvest</h2>
            <p>Ekosistem tambak yang seimbang dengan alam memberikan hasil panen yang lebih optimal dan aman.</p>
            <p style="font-size: 0.95rem;">Dengan melestarikan hutan bakau (mangrove) di sekitar pesisir tambak, kami menyaring inlet air laut secara alami. Hubungan simbiotik ini menjamin air kolam kaya akan nutrisi natural dan bebas kontaminan berbahaya, melahirkan udang dengan rasa manis alami dan tekstur yang lebih garing.</p>
          </div>
          <div class="reveal delay-200">
            <div style="width: 100%; max-height: 380px; overflow: hidden; aspect-ratio: 16/9;">
<div style="width: 100%; max-width: 800px; margin: 0 auto; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.1); aspect-ratio: 16/9;">
  <div style="width: 100%; max-width: 800px; margin: 0 auto; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.1); aspect-ratio: 16/9;">
  <iframe 
    src="https://www.youtube.com/embed/4fT5YaCDzF0?si=8rY0L7SvXL0EURyW" 
    style="width: 100%; height: 100%; border: none;" 
    title="YouTube video player" 
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
    referrerpolicy="strict-origin-when-cross-origin" 
    allowfullscreen>
  </iframe>
</div>

</div>

</div>

          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials / Trusted By Section -->
    <section>
      <div class="container">
        <div class="section-header center reveal" style="margin-bottom: 1.5rem;">
          <h2 style="font-size: 2.2rem; font-weight: 800;">Trusted by Strategic Partners</h2>
          <p>Jaringan hotel, restoran, katering, dan ritel yang mempercayakan kebutuhan pasokan udang mereka kepada Nautera.</p>
        </div>
        
        <div class="partner-marquee-wrapper reveal">
          <div class="partner-marquee-track">
            <div class="partner-circle-slot" title="Alfamart">
              <img src="/assets/images/ampera.jpg" alt="Partner 1" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
              <div class="partner-circle-badge badge-alfa"><span>a</span></div>
            </div>
            <div class="partner-circle-slot" title="KURTII">
              <img src="/assets/images/kumi.png" alt="Partner 2" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
              <div class="partner-circle-badge badge-kurti"><span><i class="fa-solid fa-utensils"></i></span></div>
            </div>
            <div class="partner-circle-slot" title="Bamboo Eco">
              <img src="/assets/images/bambo.jpg" alt="Partner 3" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
              <div class="partner-circle-badge badge-bamboo"><span><i class="fa-solid fa-bowl-rice"></i></span></div>
            </div>
            <div class="partner-circle-slot" title="Hurti Hotel">
              <img src="/assets/images/seint.png" alt="Partner 4" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
              <div class="partner-circle-badge badge-hurti"><span><i class="fa-solid fa-fish"></i></span></div>
            </div>
            <div class="partner-circle-slot" title="SEINKIRI">
              <img src="/assets/images/hotel.png" alt="Partner 5" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
              <div class="partner-circle-badge badge-seinkiri"><span><i class="fa-solid fa-store"></i></span></div>
            </div>
            <div class="partner-circle-slot" title="Alfamart">
              <img src="/assets/images/ampera.jpg" alt="Partner 1" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
              <div class="partner-circle-badge badge-alfa"><span>a</span></div>
            </div>
            <div class="partner-circle-slot" title="KURTII">
              <img src="/assets/images/kumi.png" alt="Partner 2" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
              <div class="partner-circle-badge badge-kurti"><span><i class="fa-solid fa-utensils"></i></span></div>
            </div>
            <div class="partner-circle-slot" title="Bamboo Eco">
              <img src="/assets/images/bambo.jpg" alt="Partner 3" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
              <div class="partner-circle-badge badge-bamboo"><span><i class="fa-solid fa-bowl-rice"></i></span></div>
            </div>
